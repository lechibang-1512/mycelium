{
    "$schema": "https://unpkg.com/knip@latest/schema.json",
    "entry": [
        "backend/server.cjs",
        "frontend/main.jsx",
        "scripts/init-rbac.js",
        "scripts/jobs/*.js",
        "scripts/utils-*.js",
        "scripts/seed-db.js",
        "scripts/setup-spare-parts-recommendations.js",
        "scripts/reports/*.js",
        "scripts/tests/setup.js",
        "scripts/tests/check-dbs.js",
        "scripts/tests/cleanup-test-data.js",
        "scripts/tests/test-*.js"
    ],
    "project": [
        "backend/**/*.{js,cjs,mjs}",
        "frontend/**/*.{js,jsx}",
        "shared/**/*.{js,cjs}",
        "scripts/**/*.js"
    ],
    "ignore": [
        "dist/**",
        "node_modules/**",
        "sql/**",
        "docs/**",
        "public/**",
        "messages/**"
    ],
    "vite": {
        "config": "backend/config/vite.config.mjs",
        "entry": [
            "frontend/main.jsx"
        ]
    },
    "eslint": {
        "config": [
            "backend/config/eslint.config.js",
            "eslint.config.js"
        ]
    },
    "mocha": {
        "config": [
            "backend/config/.mocharc.js"
        ],
        "entry": [
            "scripts/tests/**/*.test.js",
            "scripts/tests/setup.js"
        ]
    }
}