{
    "$schema": "https://unpkg.com/knip@latest/schema.json",
    "entry": [
        "backend/jobs/*.js",
        "backend/models/master/index.js",
        "scripts/tools/utils-*.js",
        "scripts/tools/seed-db.js"
    ],
    "project": [
        "backend/**/*.{js,cjs,mjs}",
        "frontend/**/*.{js,jsx}",
        "scripts/**/*.js"
    ],
    "ignore": [
        "dist/**",
        "node_modules/**",
        "sql/**",
        "docs/**",
        "public/**"
    ],
    "vite": {
        "config": "backend/config/vite.config.mjs",
        "entry": [
            "frontend/main.jsx"
        ]
    },
    "eslint": {
        "config": [
            "eslint.config.mjs"
        ]
    }
}