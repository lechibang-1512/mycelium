{
  "name": "mycelium-app",
  "private": true,
  "version": "0.0.0",
  "overrides": {
    "diff": ">=8.0.3"
  },
  "scripts": {
    "start": "node backend/server.cjs",
    "dev": "npm run setup:assets && vite --config backend/config/vite.config.mjs",
    "build": "npm run clean && npm run setup:assets && npx vite build --config backend/config/vite.config.mjs && npm start",
    "build:only": "npm run clean && npm run setup:assets && npx vite build --config backend/config/vite.config.mjs",
    "build:quick": "npm run setup:assets && npx vite build --config backend/config/vite.config.mjs",
    "build:full": "npm run clean && npm run setup:assets && npx vite build --config backend/config/vite.config.mjs",
    "clean": "node ./scripts/tools/clean-simple.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "knip": "knip",
    "preview": "vite preview --config backend/config/vite.config.mjs",
    "job:recommendations": "node backend/jobs/generate-reorder-recommendations.js",
    "job:efficiency": "node backend/jobs/generate-efficiency-reports.js",
    "job:check-exp-batches": "node backend/jobs/check-expiring-batches.js",
    "job:check-exp-warranties": "node backend/jobs/check-expiring-warranties.js",
    "job:cleanup-phones": "node backend/jobs/cleanup-test-phones.js",
    "util:verify-env": "node scripts/tools/utils-verify-env.js",
    "util:extract-schema": "node scripts/tools/utils-extract-schema.js",
    "util:kill-server": "node scripts/tools/utils-killserver.js",
    "build:tex": "bash scripts/tools/compile-tex.sh",
    "safety": "bash scripts/tools/safety-check.sh",
    "safety:audit": "npm audit",
    "safety:quick": "bash scripts/tools/safety-check.sh --secrets --sql --auth --errors",
    "setup:assets": "node scripts/tools/setup-assets.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.96.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "fast-xml-parser": "^5.5.6",
    "helmet": "^8.1.0",
    "inquirer": "^12.11.0",
    "lucide-react": "^1.7.0",
    "mariadb": "^3.4.5",
    "multer": "^2.0.2",
    "node-sql-parser": "^5.3.13",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "sequelize": "^6.37.7",
    "uuid": "^13.0.0",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.3",
    "globals": "^16.4.0",
    "knip": "^5.82.1",
    "vite": "^7.1.7"
  }
}
